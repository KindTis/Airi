<Window x:Class="Airi.Views.VideoDeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비디오 삭제" Width="560" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0F111C" Foreground="#E8ECF9" FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="원본 동영상 파일을 휴지통으로 이동하시겠습니까?" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="450">
            <StackPanel>
                <TextBlock Text="제목" Foreground="#96A1C2" Margin="0,0,0,6"/>
                <TextBox x:Name="VideoTitle" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#151828" Foreground="#E8ECF9" Padding="10"/>
                <TextBlock Text="파일명" Foreground="#96A1C2" Margin="0,16,0,6"/>
                <TextBox x:Name="VideoFileName" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#151828" Foreground="#E8ECF9" Padding="10"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="휴지통으로 이동" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnConfirmClick"/>
            <Button x:Name="CancelButton" Content="취소" Style="{StaticResource SecondaryActionButtonStyle}" Margin="12,0,0,0" IsDefault="True" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
