<Window x:Class="Airi.Views.GalleryMetadataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:Airi.Domain"
        xmlns:c="clr-namespace:Airi.Controls"
        xmlns:v="clr-namespace:Airi.Views"
        Title="메타데이터 편집" Width="900" Height="680" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource GallerySurface}"
        Foreground="{StaticResource GalleryText}" FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        FontSize="14" PreviewKeyDown="OnEditorKeyDown">
  <Window.Resources>
    <c:GalleryThumbnailPreviewConverter x:Key="ThumbnailPreview" />
    <v:GalleryEditorFieldConverter x:Key="DraftField" />
    <SolidColorBrush x:Key="EditorControlBorder" Color="#626B6E" />
    <Style x:Key="EditorSectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="EditorToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource GalleryHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorControlBorder}" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource GalleryMuted}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EditorFieldOption" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource GalleryMuted}" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="EditorFieldTemplate">
      <StackPanel>
        <Grid Margin="0,0,0,4" MinHeight="20">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="FieldLabel" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox Content="적용" Style="{StaticResource EditorFieldOption}" Margin="0,0,8,0"
                      AutomationProperties.Name="{Binding Label,StringFormat={}{0} 적용}" IsChecked="{Binding IsApplied,Mode=TwoWay}" />
            <CheckBox Content="수동 보호" Style="{StaticResource EditorFieldOption}"
                      AutomationProperties.Name="{Binding Label,StringFormat={}{0} 수동 변경 보호}" IsChecked="{Binding IsLocked,Mode=TwoWay}" />
          </StackPanel>
          <Button x:Name="TranslateDescription" Grid.Column="2" Content="설명 번역" Margin="9,0,0,0"
                  Style="{StaticResource EditorToolButton}" MinHeight="27" Padding="8,3" FontSize="11" Visibility="Collapsed"
                  Command="{Binding DataContext.TranslateDraftDescriptionCommand,RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
        <TextBox AutomationProperties.Name="{Binding Label}" AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}"
                 AutomationProperties.HelpText="적용할 필드의 값을 편집합니다. 빈 값도 명시적으로 적용할 수 있습니다."
                 Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsApplied}" TextWrapping="Wrap">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="FontSize" Value="14" />
              <Setter Property="BorderBrush" Value="{StaticResource EditorControlBorder}" />
              <Setter Property="Padding" Value="10,6" />
              <Setter Property="MinHeight" Value="34" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Field}" Value="{x:Static d:MetadataField.Description}">
                  <Setter Property="AcceptsReturn" Value="True" />
                  <Setter Property="VerticalContentAlignment" Value="Top" />
                  <Setter Property="MinHeight" Value="62" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Field}" Value="{x:Static d:MetadataField.Description}">
          <Setter TargetName="TranslateDescription" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="EditorField" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate" Value="{StaticResource EditorFieldTemplate}" />
      <Style.Triggers>
        <Trigger Property="Content" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,0,0,1" Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="EditorTitle" Text="메타데이터 편집" FontSize="22" FontWeight="DemiBold"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                   MaxHeight="52" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="RefreshMetadata" Grid.Column="1" Content="메타데이터 갱신" Style="{StaticResource EditorToolButton}"
                VerticalAlignment="Center" Command="{Binding FetchMetadataCommand}" Visibility="{Binding Visibility,ElementName=ThumbnailTools}" />
      </Grid>
    </Border>
    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="EditorBody" SizeChanged="OnEditorBodySizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorSidebarColumn" Width="266" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="EditorPanel" Grid.Column="1" Margin="22,14,22,8">
          <TextBlock x:Name="EditorHint" Text="체크한 항목만 수정합니다." Foreground="{StaticResource GalleryMuted}"
                     LineHeight="20.4" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />
          <TextBlock Text="{Binding EditorDraft.ProposalSource,StringFormat=출처: {0}}" Foreground="{StaticResource GalleryMuted}"
                     Margin="0,0,0,7" Visibility="{Binding EditorDraft.ProposalSource,Converter={StaticResource GalleryVisibility}}" />
          <TextBlock Text="{Binding EditorDraft.ProposalReason}" Foreground="{StaticResource GalleryMuted}" TextWrapping="Wrap"
                     Margin="0,0,0,8" Visibility="{Binding EditorDraft.ProposalReason,Converter={StaticResource GalleryVisibility}}" />
          <StackPanel x:Name="EditorFields">
            <TextBlock Text="기본 정보" Style="{StaticResource EditorSectionLabel}" Foreground="{StaticResource GalleryMuted}" Margin="0,0,0,7" />
            <ContentControl x:Name="TitleField" Style="{StaticResource EditorField}" Margin="0,0,0,8"
                            Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Title}}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <ContentControl x:Name="DateField" Style="{StaticResource EditorField}"
                              Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Date}}" />
              <ContentControl x:Name="StudioField" Grid.Column="2" Style="{StaticResource EditorField}"
                              Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Studio}}" />
            </Grid>
            <Border BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,8,0,0">
              <StackPanel>
                <TextBlock Text="분류" Style="{StaticResource EditorSectionLabel}" Foreground="{StaticResource GalleryMuted}" Margin="0,0,0,7" />
                <ContentControl x:Name="ActorsField" Style="{StaticResource EditorField}"
                                Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Actors}}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource EditorField}"
                                  Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Genres}}" />
                  <ContentControl Grid.Column="2" Style="{StaticResource EditorField}"
                                  Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Tags}}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,8,0,0"
                    Visibility="{Binding Visibility,ElementName=DescriptionField}">
              <ContentControl x:Name="DescriptionField" Style="{StaticResource EditorField}"
                              Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Description}}" />
            </Border>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding EditorDraft.TargetResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,7">
                  <TextBlock Text="{Binding TargetTitle}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource GalleryMuted}" /><TextBlock Text="{Binding Source,StringFormat=출처: {0}}" Foreground="{StaticResource GalleryMuted}" Visibility="{Binding Source,Converter={StaticResource GalleryVisibility}}"/>
                  <TextBlock Text="{Binding Reason}" Foreground="{StaticResource GalleryMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="ChangesList" ItemsSource="{Binding EditorDraft.Changes}" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,13" BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <TextBlock Text="{Binding TargetTitle}" FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Field,Converter={StaticResource GalleryFieldLabel}}" Foreground="{StaticResource GalleryMuted}" LineHeight="21.6"/>
                      <StackPanel Grid.Column="2"><TextBlock Text="{Binding Converter={StaticResource GalleryChangeLabel},ConverterParameter=Before}" TextDecorations="Strikethrough" Foreground="{StaticResource GalleryMuted}" TextWrapping="Wrap" LineHeight="21.6"/>
                      <TextBlock Text="{Binding Converter={StaticResource GalleryChangeLabel},ConverterParameter=After}" Foreground="{StaticResource GalleryAccent}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="21.6"/>
                      <TextBlock Text="보호 설정 변경" Foreground="{StaticResource GalleryMuted}" Visibility="{Binding LockChanged,Converter={StaticResource GalleryVisibility}}"/></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding EditorDraft.Error}" Foreground="{StaticResource GalleryDanger}" TextWrapping="Wrap" Margin="0,8" />
        </StackPanel>
        <Border x:Name="EditorSidebar" Background="{StaticResource GalleryPanel}" BorderBrush="{StaticResource GalleryLine}"
                BorderThickness="0,0,1,0" Padding="20,14,20,16" Visibility="{Binding Visibility,ElementName=ThumbnailTools}">
          <StackPanel x:Name="ThumbnailTools" MaxWidth="224" HorizontalAlignment="Left">
            <TextBlock Text="썸네일" Style="{StaticResource EditorSectionLabel}" Margin="0,0,0,8" />
            <c:GalleryRoundedBorder Background="{StaticResource GalleryBackground}" CornerRadius="7" Width="224" Height="150.64">
              <Image x:Name="EditorThumbnailPreview" Source="{Binding EditorDraft.ThumbnailEditor.ThumbnailPreviewUri,Converter={StaticResource ThumbnailPreview}}" Stretch="UniformToFill" />
            </c:GalleryRoundedBorder>
            <Button x:Name="ChooseThumbnail" Content="이미지 선택" Click="OnChooseThumbnailClick" Style="{StaticResource EditorToolButton}" Margin="0,10,0,0" />
            <Button x:Name="GenerateThumbnail" Content="영상에서 생성" Click="OnGenerateGalleryThumbnailClick" Style="{StaticResource EditorToolButton}" Margin="0,7,0,0" />
            <Button Content="썸네일 초기화" Click="OnResetGalleryThumbnailClick" Style="{StaticResource GalleryQuiet}" MinHeight="28"
                    Foreground="{StaticResource GalleryMuted}" Padding="6,3" Margin="0,6,0,0" />
            <Border BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,12,0,0">
              <StackPanel>
                <TextBlock Text="파일 정보" Style="{StaticResource EditorSectionLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="EditorSourcePath" Text="{Binding InspectedVideo.SourcePath,Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Padding="0" Background="Transparent"
                         BorderThickness="0" Foreground="{StaticResource GalleryMuted}" FocusVisualStyle="{StaticResource GalleryFocus}"
                         AutomationProperties.Name="전체 파일 경로" />
                <WrapPanel Margin="0,6,0,0">
                  <TextBlock Text="{Binding InspectedVideo.SizeBytes,StringFormat={}{0:N0} bytes}" Foreground="{StaticResource GalleryMuted}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding InspectedVideo.CreatedLabel,StringFormat=수정일 {0}}" Foreground="{StaticResource GalleryMuted}" />
                </WrapPanel>
                <TextBlock Text="{Binding InspectedVideo.ProductCode,StringFormat=작품 번호 {0}}" Foreground="{StaticResource GalleryMuted}"
                           Margin="0,6,0,0" Visibility="{Binding InspectedVideo.ProductCode,Converter={StaticResource GalleryVisibility}}" />
                <TextBlock Text="{Binding InspectedVideo.RecycleStatusLabel}" Foreground="{StaticResource GalleryDanger}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="{Binding InspectedVideo.RecycleStatusLabel,Converter={StaticResource GalleryVisibility}}" />
                <TextBlock x:Name="EditorRecycleReason" Text="{Binding InspectedVideo.RecycleReason}" Foreground="{StaticResource GalleryMuted}"
                           TextWrapping="Wrap" Visibility="{Binding InspectedVideo.RecycleReason,Converter={StaticResource GalleryVisibility}}" />
              </StackPanel>
            </Border>
            <Expander Header="썸네일 경로 및 보호" Foreground="{StaticResource GalleryMuted}" Margin="0,10,0,0">
              <ContentControl Style="{StaticResource EditorField}" Margin="0,6,0,0"
                              Content="{Binding EditorDraft,Converter={StaticResource DraftField},ConverterParameter={x:Static d:MetadataField.Thumbnail}}" />
            </Expander>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    <Border x:Name="EditorActionsPanel" Grid.Row="2" Background="{StaticResource GalleryPanel}"
            BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Padding="22,9"
            Visibility="{Binding Visibility,ElementName=EditorPanel}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="EditorPreservation" Text="원본 파일과 경로는 변경하지 않습니다." Foreground="{StaticResource GalleryMuted}"
                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="EditorCancel" Content="취소" Command="{Binding CancelEditCommand}" Style="{StaticResource GalleryQuiet}" Margin="0,0,8,0" />
          <Button x:Name="EditorBack" Content="돌아가기" Command="{Binding BackToEditCommand}" Style="{StaticResource GalleryQuiet}" Margin="0,0,8,0" Visibility="Collapsed" />
          <Button x:Name="EditorPreview" Content="변경 미리보기" Command="{Binding PreviewChangesCommand}" Style="{StaticResource GalleryPrimary}" MinWidth="92" Visibility="Collapsed" />
          <Button x:Name="EditorApply" Content="저장" Command="{Binding ApplyChangesCommand}" Style="{StaticResource GalleryPrimary}" MinWidth="92" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
