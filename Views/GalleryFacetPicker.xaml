<UserControl x:Class="Airi.Views.GalleryFacetPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Airi.Controls" x:Name="Picker" FontSize="12">
  <Grid>
    <Button x:Name="Trigger" Style="{StaticResource GalleryDropdownTrigger}" Padding="10,9" MinHeight="37" Click="Toggle" HorizontalContentAlignment="Stretch">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="12" />
        </Grid.ColumnDefinitions>
        <c:GalleryIcon x:Name="LeadingIcon" Kind="{Binding Icon,ElementName=Picker}" Margin="0,0,8,0" Foreground="{DynamicResource GalleryText}" />
        <TextBlock Grid.Column="1" x:Name="Summary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <c:GalleryIcon Grid.Column="2" Kind="chevron" Width="12" Height="12" Foreground="{DynamicResource GalleryMuted}" />
      </Grid>
    </Button>
    <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=Trigger}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False">
      <Border Background="{DynamicResource GallerySurface}" BorderBrush="{DynamicResource GalleryLine}" BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="210">
        <StackPanel>
          <TextBox x:Name="Search" Margin="4,2,4,5" Padding="8,6" TextChanged="Filter" AutomationProperties.Name="분류 후보 검색" />
          <ListBox x:Name="OptionsList" MaxHeight="320" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="9,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource GalleryMuted}" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>