<Window xmlns:d="clr-namespace:Airi.Domain" x:Class="Airi.MainWindow" x:Name="Shell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Airi" xmlns:c="clr-namespace:Airi.Controls" xmlns:v="clr-namespace:Airi.Views" xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel" Title="Airi" Width="1600" Height="980" MinWidth="340" MinHeight="400" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnVideoDeleteKeyUp" Background="#181C1E" FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic" FontSize="14" UseLayoutRounding="False" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="GalleryNav" TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="37" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Nav" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Nav" Property="Background" Value="{StaticResource GalleryHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="GalleryCard">
        <Grid Width="{Binding Tag.Metrics.ColumnStride,RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.Metrics.RowStride,RelativeSource={RelativeSource AncestorType=ListBox}}">
          <StackPanel Width="{Binding Tag.Metrics.CardWidth,RelativeSource={RelativeSource AncestorType=ListBox}}" HorizontalAlignment="Left" Background="Transparent">
            <Grid Height="{Binding Tag.Metrics.CoverHeight,RelativeSource={RelativeSource AncestorType=ListBox}}">
              <c:GalleryRoundedBorder Width="{Binding Tag.Metrics.CardWidth,RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.Metrics.CoverHeight,RelativeSource={RelativeSource AncestorType=ListBox}}" CornerRadius="7" Background="{StaticResource GalleryPanel}">
                <Image Source="{Binding ThumbnailSource}" Tag="MainCardThumbnail" Loaded="OnThumbnailImageLoaded" Unloaded="OnThumbnailImageUnloaded" DataContextChanged="OnThumbnailImageDataContextChanged" Width="{Binding Tag.Metrics.CardWidth,RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.Metrics.CoverHeight,RelativeSource={RelativeSource AncestorType=ListBox}}" Stretch="UniformToFill" />
              </c:GalleryRoundedBorder>
              <Border x:Name="ActiveOutline" BorderThickness="2" CornerRadius="7" BorderBrush="Transparent" IsHitTestVisible="False" />
              <CheckBox Style="{StaticResource GalleryCardCheck}" x:Name="CardCheck" IsChecked="{Binding IsChecked,Mode=OneWay}" Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Focusable="False" IsHitTestVisible="False" Visibility="{Binding IsGallerySelectionMode,RelativeSource={RelativeSource AncestorType=local:MainWindow},Converter={StaticResource GalleryVisibility},FallbackValue=Collapsed}" AutomationProperties.Name="영상 선택" />
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,5" Background="{StaticResource GalleryTint}" CornerRadius="5" Visibility="{Binding IsMissing,Converter={StaticResource GalleryVisibility}}">
                <TextBlock Text="파일 없음" Foreground="{StaticResource GalleryDanger}" />
              </Border>
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,5" Background="{StaticResource GalleryTint}" CornerRadius="5" Visibility="{Binding RecycleStatusLabel,Converter={StaticResource GalleryVisibility}}">
                <TextBlock Text="{Binding RecycleStatusLabel}" Foreground="{StaticResource GalleryAccent}" />
              </Border>
            </Grid>
            <TextBlock x:Name="CardTitle" FontWeight="SemiBold" FontSize="{Binding Tag.Metrics.CardTitleSize,RelativeSource={RelativeSource AncestorType=ListBox}}" LineHeight="20.3" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource GalleryDisplayTitle}"><Binding Path="Title"/><Binding Path="SourcePath"/><Binding Path="LibraryPath"/></MultiBinding></TextBlock.Text></TextBlock>
            <Grid x:Name="DesktopMeta" Margin="0,3,0,0" Height="19.2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="CardProductCode" Text="{Binding ProductCode}" Foreground="{StaticResource GalleryAccent}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="CardActors" Grid.Column="1" Margin="8,0,0,0" TextAlignment="Right"
                         Text="{Binding DisplayActors,Converter={StaticResource GalleryLabel},ConverterParameter=배우}" Foreground="{StaticResource GalleryMuted}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <StackPanel x:Name="CompactMeta" Visibility="Collapsed" Margin="0,5,0,0">
              <TextBlock x:Name="CompactProductCode" Text="{Binding ProductCode}" Height="19.2" Foreground="{StaticResource GalleryAccent}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="CompactActors" Text="{Binding DisplayActors,Converter={StaticResource GalleryLabel},ConverterParameter=배우}" Height="19.2" Foreground="{StaticResource GalleryMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsActive}" Value="True"/>
              <Condition Binding="{Binding IsGallerySelectionMode,RelativeSource={RelativeSource AncestorType=local:MainWindow},FallbackValue=False}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="ActiveOutline" Property="BorderBrush" Value="{StaticResource GalleryAccent}" />
          </MultiDataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsChecked}" Value="True"/>
              <Condition Binding="{Binding IsGallerySelectionMode,RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="ActiveOutline" Property="BorderBrush" Value="{StaticResource GalleryAccent}" />
          </MultiDataTrigger>
          <DataTrigger Binding="{Binding Tag.Metrics.Short,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
            <Setter TargetName="CardTitle" Property="Margin" Value="0,10,0,0" />
            <Setter TargetName="DesktopMeta" Property="Margin" Value="0,5,0,0" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tag.Metrics.Compact,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
            <Setter TargetName="CardTitle" Property="LineHeight" Value="17.4" />
            <Setter TargetName="DesktopMeta" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="CompactMeta" Property="Visibility" Value="Visible" />
            <Setter TargetName="CardCheck" Property="Width" Value="16" />
            <Setter TargetName="CardCheck" Property="Height" Value="16" />
            <Setter TargetName="CardCheck" Property="Margin" Value="7" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Border BorderBrush="{StaticResource GalleryLine}" BorderThickness="1" CornerRadius="10" Background="{StaticResource GalleryBackground}">
      <ScrollViewer x:Name="PageScroll" PanningMode="VerticalOnly" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="OnPageMouseWheel">
        <c:GalleryPageScrollHost x:Name="GalleryHost">
          <c:GalleryPageScrollHost.Header>
            <Border x:Name="GalleryHeader" Background="{StaticResource GallerySurface}" BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,0,0,1" Padding="24,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition x:Name="HeaderSpacerColumn" Width="*" />
                  <ColumnDefinition x:Name="HeaderSearchColumn" Width="1.5*" MaxWidth="600" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="LogoMark" Width="29" Height="29" CornerRadius="7" Background="{StaticResource GalleryAccent}">
                    <Path Data="M11,8 L20,14 11,20 Z" Fill="{StaticResource GallerySurface}" Stretch="None" />
                  </Border>
                  <TextBlock x:Name="Wordmark" Text="Airi" FontSize="26" FontWeight="650" Foreground="{StaticResource GalleryAccent}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="HeaderCaption" Grid.Column="1" Text="나의 비디오 라이브러리" Foreground="{StaticResource GalleryMuted}" Margin="24,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="SearchBorder" Grid.Column="3" Height="39" Background="{StaticResource GalleryBackground}" BorderBrush="{StaticResource GalleryLine}" BorderThickness="1" CornerRadius="7" Padding="12,0" Margin="24,0,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="17" />
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:GalleryIcon Kind="search" Foreground="{StaticResource GalleryMuted}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                      <TextBox x:Name="SearchInput" Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.Name="영상 검색" />
                      <TextBlock Text="제목, 배우, 태그 검색" Foreground="{StaticResource GalleryMuted}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <Border x:Name="SearchShortcut" Grid.Column="2" BorderBrush="{StaticResource GalleryLine}" BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="/" Foreground="{StaticResource GalleryMuted}" />
                    </Border>
                  </Grid>
                </Border>
                <Button x:Name="RandomPlayButton" Grid.Column="4" Command="{Binding RandomPlayCommand}" Style="{StaticResource GalleryPrimary}" Height="37" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="임의 영상 재생" AutomationProperties.Name="임의 재생">
                  <StackPanel Orientation="Horizontal">
                    <c:GalleryIcon x:Name="RandomPlayIcon" Kind="shuffle" Margin="0,0,7,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock x:Name="RandomPlayLabel" Text="임의 재생" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </c:GalleryPageScrollHost.Header>
          <c:GalleryPageScrollHost.Sidebar>
            <Border Background="{StaticResource GalleryPanel}" BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,0,1,0" Padding="15,25,15,20">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="라이브러리" Foreground="{StaticResource GalleryMuted}" FontWeight="SemiBold" Margin="9,0,9,9" />
                  <Button x:Name="NavAll" Style="{StaticResource GalleryNav}" Tag="All" Click="OnViewClick">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <c:GalleryIcon Kind="film" Width="16" Height="16" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Grid.Column="1" Text="전체 영상" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding NormalCount}" Foreground="{StaticResource GalleryMuted}" />
                    </Grid>
                  </Button>
                  <Button x:Name="NavIncomplete" Style="{StaticResource GalleryNav}" Tag="Incomplete" Click="OnViewClick">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <c:GalleryIcon Kind="info" Width="16" Height="16" />
                      <TextBlock Grid.Column="1" Text="정보 미완성" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding IncompleteCount}" Foreground="{StaticResource GalleryMuted}" />
                    </Grid>
                  </Button>
                  <Button x:Name="NavMissing" Style="{StaticResource GalleryNav}" Tag="Missing" Click="OnViewClick">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <c:GalleryIcon Kind="warning" Width="16" Height="16" />
                      <TextBlock Grid.Column="1" Text="파일 없음" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding MissingCount}" Foreground="{StaticResource GalleryMuted}" />
                    </Grid>
                  </Button>
                  <Button x:Name="NavTrash" Style="{StaticResource GalleryNav}" Tag="Trash" Click="OnViewClick">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <c:GalleryIcon Kind="trash" Width="16" Height="16" />
                      <TextBlock Grid.Column="1" Text="휴지통" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding TrashCount}" Foreground="{StaticResource GalleryMuted}" />
                    </Grid>
                  </Button>
                  <TextBlock Text="{Binding AttentionCount,StringFormat='진행·확인 필요 {0}개'}" Foreground="{StaticResource GalleryDanger}" TextWrapping="Wrap" Margin="10,8" Visibility="{Binding AttentionCount,Converter={StaticResource GalleryVisibility}}" />
                  <Border Height="1" Background="{StaticResource GalleryLine}" Margin="5,20" />
                  <TextBlock Text="라이브러리 폴더" FontWeight="SemiBold" Foreground="{StaticResource GalleryMuted}" Margin="9,0,9,9" />
                  <ItemsControl ItemsSource="{Binding LibraryFolderPaths}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource GalleryNav}" Click="OnLibraryFolderClick" ToolTip="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <c:GalleryIcon Kind="folder" Width="16" Height="16" Foreground="{StaticResource GalleryMuted}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Converter={StaticResource GalleryFolderLabel}}" TextTrimming="CharacterEllipsis" MaxWidth="95" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </c:GalleryPageScrollHost.Sidebar>
          <c:GalleryPageScrollHost.Prefix>
            <StackPanel x:Name="GalleryPrefix">
              <Grid x:Name="FacetShelf" Margin="25,15,25,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="125"/><ColumnDefinition Width="9"/>
                  <ColumnDefinition Width="125"/><ColumnDefinition Width="9"/>
                  <ColumnDefinition Width="125"/><ColumnDefinition Width="9"/>
                  <ColumnDefinition Width="170"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <v:GalleryFacetPicker x:Name="ActorPicker" Label="배우" Icon="person" Options="{Binding ActorFacets}"/>
                <v:GalleryFacetPicker x:Name="StudioPicker" Grid.Column="2" Label="제작사" Icon="studio" Options="{Binding StudioFacets}"/>
                <v:GalleryFacetPicker x:Name="GenrePicker" Grid.Column="4" Label="장르" Icon="tag" Options="{Binding GenreFacets}"/>
                <ComboBox x:Name="SortPicker" Grid.Column="6" Tag="{Binding ElementName=GalleryHost}" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSortOption}" ToolTip="{Binding SelectedSortOption.Label}" AutomationProperties.Name="영상 정렬"/>
                <Border x:Name="SelectionModeControl" Grid.ColumnSpan="8" HorizontalAlignment="Right" Width="144" MinHeight="37"
                        BorderThickness="1" CornerRadius="7">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource GalleryLine}"/>
                      <Setter Property="Background" Value="{StaticResource GallerySurface}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGallerySelectionMode,ElementName=Shell}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource GalleryAccent}"/>
                          <Setter Property="Background" Value="{StaticResource GalleryTint}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions>
                    <Button x:Name="SelectionModeButton" Padding="5,6" Click="OnSelectionModeClick"
                            AutomationProperties.Name="{Binding Text,ElementName=SelectionModeLabel}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
                          <Setter Property="Grid.ColumnSpan" Value="2"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGallerySelectionMode,ElementName=Shell}" Value="True">
                              <Setter Property="Grid.ColumnSpan" Value="1"/>
                              <Setter Property="Foreground" Value="{StaticResource GalleryAccent}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <StackPanel Orientation="Horizontal">
                        <c:GalleryIcon x:Name="SelectionModeIcon" Kind="checkbox" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource GalleryMuted}">
                          <c:GalleryIcon.Style>
                            <Style TargetType="c:GalleryIcon">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGallerySelectionMode,ElementName=Shell}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </c:GalleryIcon.Style>
                        </c:GalleryIcon>
                        <TextBlock x:Name="SelectionModeLabel" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="다중 선택"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGallerySelectionMode,ElementName=Shell}" Value="True">
                                  <Setter Property="Text" Value="선택 종료"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Border x:Name="SelectionCountBadge" Margin="5,0,0,0" Padding="4,1" MinWidth="19" MaxWidth="52"
                                VerticalAlignment="Center" Background="{StaticResource GalleryAccent}" CornerRadius="5">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGallerySelectionMode,ElementName=Shell}" Value="True"/>
                                    <Condition Binding="{Binding CheckedCount,Converter={StaticResource GalleryVisibility}}" Value="Visible"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock x:Name="SelectionCountText" Text="{Binding CheckedCount}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource GalleryAccentText}" TextAlignment="Center"/>
                        </Border>
                      </StackPanel>
                    </Button>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource GalleryLine}"
                            Visibility="{Binding IsGallerySelectionMode,ElementName=Shell,Converter={StaticResource GalleryVisibility}}">
                      <Button x:Name="SelectionActionsButton" Padding="0" Click="OnSelectionActionsClick"
                              ToolTip="선택한 영상의 일괄 작업" AutomationProperties.Name="선택한 영상의 일괄 작업"
                              AutomationProperties.HelpText="{Binding CheckedCount,StringFormat='{}선택한 영상 {0}개'}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
                            <Setter Property="Foreground" Value="{StaticResource GalleryAccent}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CheckedCount}" Value="0">
                                <Setter Property="IsEnabled" Value="False"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <c:GalleryIcon Kind="chevron" Width="13" Height="13"
                                       Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Button.ContextMenu>
                          <ContextMenu x:Name="SelectionActionsMenu" Placement="Bottom" MinWidth="170"
                                       DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                            <MenuItem x:Name="FilteredSelectionSummary" Focusable="False" IsHitTestVisible="False"
                                      Foreground="{StaticResource GalleryMuted}"
                                      Visibility="{Binding HiddenCheckedCount,Converter={StaticResource GalleryVisibility}}">
                              <MenuItem.Header>
                                <TextBlock Text="{Binding HiddenCheckedCount,StringFormat='{}필터 밖 영상 {0}개 포함'}"
                                           Foreground="{StaticResource GalleryMuted}"/>
                              </MenuItem.Header>
                            </MenuItem>
                            <MenuItem x:Name="SelectionRefreshItem" Header="메타데이터 갱신" Command="{Binding FetchMetadataCommand}"/>
                            <MenuItem x:Name="SelectionDeleteItem" Header="삭제" Command="{Binding DeleteCommand}" Foreground="{StaticResource GalleryDanger}"/>
                            <MenuItem x:Name="SelectionRestoreItem" Header="복원" Command="{Binding RestoreCommand}" Visibility="Collapsed"/>
                            <Separator/>
                            <MenuItem x:Name="SelectionClearItem" Header="선택 해제" Command="{Binding ClearCheckedCommand}"/>
                          </ContextMenu>
                        </Button.ContextMenu>
                      </Button>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
              <WrapPanel x:Name="Chips" Margin="25,0,25,7" MinHeight="26.8">
                <Button x:Name="MobileFilter" Content="전체 영상" Style="{StaticResource GalleryToolbarButton}" Click="OnMobileFilterClick" Visibility="Collapsed" Margin="0,0,8,0"/>
                <TextBlock x:Name="ViewContext" Foreground="{StaticResource GalleryMuted}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                <TextBlock x:Name="LibraryCounts" Foreground="{StaticResource GalleryMuted}" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Run Text="결과 "/><Run Text="{Binding ResultCount,Mode=OneWay}"/><Run Text="개 · 보관 "/><Run Text="{Binding NormalCount,Mode=OneWay}"/><Run Text="개"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding QueryChips}" MaxWidth="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=WrapPanel}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding RemoveCommand}" Style="{StaticResource GalleryChip}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Label}" Foreground="{StaticResource GalleryAccent}"/>
                          <c:GalleryIcon Kind="close" Width="12" Height="12" Foreground="{StaticResource GalleryAccent}" Margin="6,0,0,0"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ClearFilters" Content="전체 해제" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GalleryQuiet}" MinHeight="26" Padding="3,5" Foreground="{StaticResource GalleryMuted}"/>
              </WrapPanel>
              <Border BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,0,0,1"/>
            </StackPanel>
          </c:GalleryPageScrollHost.Prefix>
          <c:GalleryPageScrollHost.List>
            <Grid>
              <ListBox x:Name="VideoList" AutomationProperties.Name="영상 결과" AutomationProperties.HelpText="마우스를 올리거나 방향키로 선택합니다. Enter 또는 더블 클릭으로 재생하고 F1로 편집합니다." Tag="{Binding ElementName=GalleryHost}" ItemsSource="{Binding FilteredVideos}" SelectedItem="{Binding SelectedVideo,Mode=TwoWay}" MouseDoubleClick="VideoList_MouseDoubleClick" ContextMenuOpening="OnGalleryContextMenuOpening" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource GalleryCard}">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0">
                      <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Padding="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                    PanningMode="{TemplateBinding ScrollViewer.PanningMode}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                      </ScrollViewer>
                    </Border>
                  </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryFocus}" />
                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                    <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <EventSetter Event="Loaded" Handler="OnGalleryCardLoaded" />
                    <EventSetter Event="MouseEnter" Handler="OnGalleryCardEnter" />
                    <EventSetter Event="MouseLeave" Handler="OnGalleryCardLeave" />
                    <EventSetter Event="GotKeyboardFocus" Handler="OnGalleryCardFocus" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGalleryCardMouseDown" />
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnGalleryCardClick" />
                    <EventSetter Event="Unloaded" Handler="OnGalleryCardUnloaded" />
                    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource GalleryDisplayTitle}"><Binding Path="Title"/><Binding Path="SourcePath"/><Binding Path="LibraryPath"/></MultiBinding></Setter.Value></Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsGallerySelectionMode,RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                        <Setter Property="Cursor" Value="Hand"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="AutomationProperties.ItemStatus" Value="일괄 작업 선택됨"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None" StretchItems="False" ItemSize="{Binding Tag.Metrics.ItemSize,RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed">
                <c:GalleryIcon Kind="film" Width="35" Height="35" Foreground="{StaticResource GalleryMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="영상을 찾을 수 없습니다" x:Name="EmptyTitle" FontSize="19" Margin="0,15,0,9" HorizontalAlignment="Center" />
                <TextBlock Text="검색어나 선택한 필터를 바꿔 보세요." Foreground="{StaticResource GalleryMuted}" HorizontalAlignment="Center" />
                <Button Content="필터 전체 해제" Command="{Binding ClearFiltersCommand}" Margin="0,10" />
              </StackPanel>
              <TextBlock x:Name="LoadingState" Text="라이브러리를 불러오는 중…" Foreground="{StaticResource GalleryMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowVideoSkeleton,Converter={StaticResource GalleryVisibility}}" />
            </Grid>
          </c:GalleryPageScrollHost.List>
          <c:GalleryPageScrollHost.Suffix>
            <Border Panel.ZIndex="1" Background="{StaticResource GallerySurface}" BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Padding="12,1" MinHeight="31">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource GalleryMuted}" VerticalAlignment="Center">
                  <Run Text="● " Foreground="{StaticResource GalleryAccent}" />
                  <Run Text="로컬 라이브러리" />
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource GalleryMuted}" TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0" />
                <Button x:Name="StatusHistory" Grid.Column="2" Style="{StaticResource GalleryToolbarButton}" Click="OnHistoryClick">
                  <TextBlock><Run Text="변경 내역 "/><Run Text="{Binding ChangeHistory.Count,Mode=OneWay}"/></TextBlock>
                </Button>
              </Grid>
            </Border>
          </c:GalleryPageScrollHost.Suffix>
        </c:GalleryPageScrollHost>
      </ScrollViewer>
    </Border>
    <c:GalleryPointerPopup x:Name="GalleryDetail" AllowsTransparency="True" StaysOpen="True" Focusable="False" Placement="Absolute" Opened="OnGalleryPopupOpened" Closed="OnGalleryPopupClosed">
      <c:GalleryDialogSurface x:Name="DetailSurface" AutomationProperties.Name="영상 상세정보" AutomationProperties.HelpText="읽기 전용 영상 요약. Enter로 재생하고 F1로 전체 정보를 확인하거나 편집합니다." IsDialogOpen="{Binding IsOpen,ElementName=GalleryDetail}" IsHitTestVisible="False" Focusable="False" Margin="40" Width="484" Padding="12" CornerRadius="12" Background="{StaticResource GallerySurface}">
        <c:GalleryDialogSurface.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity=".4"/></c:GalleryDialogSurface.Effect>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="16"/></Grid.RowDefinitions>
          <Grid x:Name="DetailBody" ClipToBounds="True" DataContext="{Binding InspectedVideo}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="DetailBodyGap" Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <c:GalleryRoundedBorder x:Name="DetailCoverFrame" CornerRadius="7" Width="460" Height="309.35" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource GallerySurface}">
              <Grid>
                <Image x:Name="GalleryCover" Source="{Binding ThumbnailSource}" Stretch="UniformToFill">
                  <Image.Style>
                    <Style TargetType="Image">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility,ElementName=GalleryPreviewFrame}" Value="Visible">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
                <Image x:Name="GalleryPreviewFrame" Stretch="Uniform" Visibility="Collapsed"/>
                <ProgressBar x:Name="GalleryPreviewProgress" Height="4" VerticalAlignment="Bottom" Minimum="0" Maximum="100" Foreground="{StaticResource GalleryAccent}" Background="{StaticResource GalleryPanel}" Visibility="Collapsed"/>
              </Grid>
            </c:GalleryRoundedBorder>
            <StackPanel x:Name="DetailReadOnly" Grid.Row="2" VerticalAlignment="Top">
              <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="620" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="26" LineStackingStrategy="BlockLineHeight" MaxHeight="52" Margin="0,0,0,8"><TextBlock.Text><MultiBinding Converter="{StaticResource GalleryDisplayTitle}"><Binding Path="Title"/><Binding Path="SourcePath"/><Binding Path="LibraryPath"/></MultiBinding></TextBlock.Text></TextBlock>
              <StackPanel x:Name="DetailDescription">
                <TextBlock Text="설명" FontSize="11" Foreground="{StaticResource GalleryMuted}" Margin="0,0,0,4" />
                <TextBlock x:Name="DetailDescriptionText" Text="{Binding Description,Converter={StaticResource GalleryPlaceholder},ConverterParameter=설명이 아직 등록되지 않았습니다.}"
                           FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" />
              </StackPanel>
              <Border x:Name="DetailFactsSection" BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,7,0,0">
                <Grid x:Name="DetailFacts">
                  <Grid.Resources>
                    <Style x:Key="DetailFactLabel" TargetType="TextBlock">
                      <Setter Property="FontSize" Value="11" />
                      <Setter Property="Foreground" Value="{StaticResource GalleryMuted}" />
                      <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                    <Style x:Key="DetailFactValue" TargetType="TextBlock">
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      <Setter Property="LineHeight" Value="18" />
                      <Setter Property="MaxHeight" Value="18" />
                    </Style>
                  </Grid.Resources>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="작품 번호" Style="{StaticResource DetailFactLabel}" />
                    <TextBlock x:Name="DetailProductCode" Text="{Binding ProductCode,Converter={StaticResource GalleryPlaceholder},ConverterParameter=미지정}"
                               Style="{StaticResource DetailFactValue}" Foreground="{StaticResource GalleryAccent}" />
                  </StackPanel>
                  <StackPanel x:Name="DetailRelease" Grid.Column="2">
                    <TextBlock Text="출시일" Style="{StaticResource DetailFactLabel}" />
                    <TextBlock Text="{Binding ReleaseLabel,Converter={StaticResource GalleryLabel}}" Style="{StaticResource DetailFactValue}" />
                  </StackPanel>
                  <StackPanel x:Name="DetailActors" Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock Text="배우" Style="{StaticResource DetailFactLabel}" />
                    <TextBlock x:Name="DetailActorsText" Text="{Binding DisplayActors,Converter={StaticResource GalleryLabel},ConverterParameter=배우}" Style="{StaticResource DetailFactValue}" />
                  </StackPanel>
                  <StackPanel x:Name="DetailStudio" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                    <TextBlock Text="제작사" Style="{StaticResource DetailFactLabel}" />
                    <TextBlock x:Name="DetailStudioText" Text="{Binding Studio,Converter={StaticResource GalleryPlaceholder},ConverterParameter=미지정}" Style="{StaticResource DetailFactValue}" />
                  </StackPanel>
                  <StackPanel x:Name="DetailGenres" Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock Text="장르" Style="{StaticResource DetailFactLabel}" />
                    <TextBlock x:Name="DetailGenresText" Text="{Binding Genres,Converter={StaticResource GalleryLabel},ConverterParameter=장르}"
                               Style="{StaticResource DetailFactValue}" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" MaxHeight="36" />
                  </StackPanel>
                  <StackPanel x:Name="DetailTags" Grid.Row="2" Grid.Column="2" Margin="0,6,0,0">
                    <TextBlock Text="태그" Style="{StaticResource DetailFactLabel}" />
                    <TextBlock x:Name="DetailTagsText" Text="{Binding Tags,Converter={StaticResource GalleryLabel},ConverterParameter=태그}"
                               Style="{StaticResource DetailFactValue}" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" MaxHeight="36" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="DetailFile" BorderBrush="{StaticResource GalleryLine}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,7,0,0">
                <StackPanel>
                  <TextBlock Text="파일 정보" FontSize="11" Foreground="{StaticResource GalleryMuted}" Margin="0,0,0,4" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailPath" Text="{Binding SourcePath}" Foreground="{StaticResource GalleryMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" LineHeight="16" MaxHeight="16" />
                    <TextBlock x:Name="DetailSize" Grid.Column="2" Text="{Binding SizeBytes,StringFormat={}{0:N0} bytes}"
                               Foreground="{StaticResource GalleryMuted}" FontSize="11" TextTrimming="CharacterEllipsis" LineHeight="16" MaxHeight="16" />
                  </Grid>
                  <TextBlock Text="{Binding RecycleStatusLabel}" Foreground="{StaticResource GalleryDanger}" FontSize="11" TextTrimming="CharacterEllipsis"
                             LineHeight="16" MaxHeight="16" Margin="0,4,0,0" Visibility="{Binding RecycleStatusLabel,Converter={StaticResource GalleryVisibility}}" />
                  <TextBlock x:Name="DetailRecycleReason" Text="{Binding RecycleReason}" Foreground="{StaticResource GalleryMuted}" FontSize="11" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32"
                             Visibility="{Binding RecycleReason,Converter={StaticResource GalleryVisibility}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" Text="F1 전체 정보·편집 · Enter 재생 · 우클릭 관리" Foreground="{StaticResource GalleryMuted}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </c:GalleryDialogSurface>
    </c:GalleryPointerPopup>
    <Border x:Name="Toast" Background="{StaticResource GalleryText}" CornerRadius="8" Padding="17,12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,47" Visibility="{Binding ToastMessage,Converter={StaticResource GalleryVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource GallerySurface}" />
        <Button Content="되돌리기" Command="{Binding UndoCommand}" Visibility="{Binding ToastUndoAvailable,Converter={StaticResource GalleryVisibility}}" Style="{StaticResource GalleryQuiet}" Foreground="{StaticResource GallerySurface}" Padding="0" MinHeight="20" Margin="18,0,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
