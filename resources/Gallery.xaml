<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Airi.Controls">
  <SolidColorBrush x:Key="GalleryBackground" Color="#181C1E" />
  <SolidColorBrush x:Key="GallerySurface" Color="#202527" />
  <SolidColorBrush x:Key="GalleryPanel" Color="#1C2123" />
  <SolidColorBrush x:Key="GalleryText" Color="#F1EEE7" />
  <SolidColorBrush x:Key="GalleryMuted" Color="#B4B7AF" />
  <SolidColorBrush x:Key="GalleryLine" Color="#363D3F" />
  <SolidColorBrush x:Key="GalleryAccent" Color="#D5B67C" />
  <SolidColorBrush x:Key="GalleryAccentText" Color="#1C211F" />
  <SolidColorBrush x:Key="GalleryTint" Color="#37372E" />
  <SolidColorBrush x:Key="GalleryHover" Color="#2B3233" />
  <SolidColorBrush x:Key="GalleryDanger" Color="#ECAAA2" />
  <c:GalleryVisibilityConverter x:Key="GalleryVisibility" />
  <c:GalleryDisplayTitleConverter x:Key="GalleryDisplayTitle"/>
  <c:GalleryTextOrPlaceholderConverter x:Key="GalleryPlaceholder"/>
  <c:GalleryChangeLabelConverter x:Key="GalleryChangeLabel"/>
  <c:GalleryMetadataFieldLabelConverter x:Key="GalleryFieldLabel"/>
  <c:GalleryListLabelConverter x:Key="GalleryLabel" />
  <c:GalleryFolderLabelConverter x:Key="GalleryFolderLabel" />
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
    <Setter Property="Background" Value="{StaticResource GallerySurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource GalleryLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MaxWidth" Value="390" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="GalleryFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border Margin="-5" BorderBrush="{StaticResource GalleryAccent}" BorderThickness="2" CornerRadius="7" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
    <Setter Property="Background" Value="{StaticResource GallerySurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource GalleryLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryFocus}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
              <ContentPresenter.Resources>
                <!-- 버튼 콘텐츠는 전역 본문 색상 대신 버튼의 Foreground를 상속한다. -->
                <Style TargetType="TextBlock" />
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{StaticResource GalleryHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GalleryQuiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="GalleryPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource GalleryAccent}" />
    <Setter Property="BorderBrush" Value="{StaticResource GalleryAccent}" />
    <Setter Property="Foreground" Value="{StaticResource GalleryAccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource GalleryHover}" />
        <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GalleryDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource GalleryDanger}" />
    <Setter Property="BorderBrush" Value="#59ECAAA2" />
  </Style>
  <Style x:Key="GalleryIconButton" TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style x:Key="GalleryToolbarButton" TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style x:Key="GalleryChip" TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
    <Setter Property="Background" Value="{StaticResource GalleryTint}"/><Setter Property="Foreground" Value="{StaticResource GalleryAccent}"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="26.8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GalleryTag" TargetType="Button" BasedOn="{StaticResource GalleryQuiet}">
    <Setter Property="Background" Value="{StaticResource GalleryPanel}"/><Setter Property="Padding" Value="7,4"/><Setter Property="MinHeight" Value="24"/><Setter Property="Margin" Value="0,0,5,5"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryFocus}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Box" Width="14" Height="14" Background="{StaticResource GalleryBackground}" BorderBrush="{StaticResource GalleryMuted}" BorderThickness="1" CornerRadius="2">
              <Grid>
                <Path x:Name="Tick" Data="M2,6 L5,9 11,2" Stroke="{StaticResource GalleryAccentText}" StrokeThickness="1.6" Visibility="Collapsed" />
                <Rectangle x:Name="Mixed" Height="2" Margin="2,0" Fill="{StaticResource GalleryAccentText}" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource GalleryAccent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GalleryAccent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource GalleryAccent}" />
              <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
    <Setter Property="Background" Value="{StaticResource GalleryBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource GalleryLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource GalleryAccent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource GalleryTint}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Input" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource GalleryAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource GalleryLine}" Margin="2" CornerRadius="3" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource GalleryMuted}" />
    <Setter Property="Background" Value="{StaticResource GalleryBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}">
                    <Grid>
                      <TextBlock Margin="7,5,20,5" Foreground="{StaticResource GalleryMuted}" Text="{Binding SelectedItem.Label,RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                      <c:GalleryIcon Kind="chevron" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,3,0" Foreground="{StaticResource GalleryMuted}" />
                    </Grid>
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border Background="{StaticResource GallerySurface}" BorderBrush="{StaticResource GalleryLine}" BorderThickness="1" CornerRadius="7" Padding="5">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource GalleryText}" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{StaticResource GalleryHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource GalleryAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GalleryCardCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Box" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{StaticResource GalleryBackground}" BorderBrush="{StaticResource GalleryMuted}" BorderThickness="1" CornerRadius="2">
            <Viewbox Margin="3">
              <Path x:Name="Tick" Data="M0,4 L3,7 9,0" Stroke="{StaticResource GalleryAccentText}" StrokeThickness="1.6" Visibility="Collapsed" />
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource GalleryAccent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GalleryAccent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}"/><Rectangle x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/><Border x:Name="Busy" Background="{TemplateBinding Foreground}" Width="70" HorizontalAlignment="Left" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform X="-70"/></Border.RenderTransform></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Busy" Property="Visibility" Value="Visible"/><Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Busy" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-70" To="390" Duration="0:0:0.9"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>